---
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';

type Props = CollectionEntry<'blog'>['data'] & { headings?: MarkdownHeading[] };

const { title, description, pubDate, updatedDate, heroImage, headings = [] } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: auto;
				max-width: none;
				margin: 0;
				padding: var(--space-page-top) var(--space-gutter) var(--space-post-bottom);
			}
			.post {
				display: grid;
				grid-template-columns: minmax(0, var(--width-content));
				justify-content: center;
				gap: 0 var(--space-post-columns);
			}
			.post-body {
				min-width: 0;
			}
			.post-side {
				display: none;
			}
			@media (min-width: 1200px) {
				.post {
					grid-template-columns: minmax(0, var(--width-content)) var(--width-toc);
				}
				.post-side {
					display: block;
					grid-column: 2;
					grid-row: 1;
				}
			}
			.hero-image img {
				margin: 0 0 2rem;
			}
			.title {
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--color-border);
			}
			.title h1 {
				margin: 0.25em 0 0;
			}
			.date {
				color: var(--color-text-muted);
				font-size: var(--font-size-meta);
				line-height: var(--line-height-ui);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article class="post">
				<div class="post-body">
					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</div>
					)}
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="last-updated-on">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1>{title}</h1>
					</div>
					<TableOfContents headings={headings} variant="mobile" />
					<div class="prose">
						<slot />
					</div>
				</div>
				<div class="post-side">
					<TableOfContents headings={headings} variant="wide" />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
